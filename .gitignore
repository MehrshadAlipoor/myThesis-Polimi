# ============================================================
# PRIVACY & DATA PROTECTION
# ============================================================
# Real patient data must NEVER be committed to this repository.
# Only the synthetic demo data under data/sample/ is allowed.

# Raw patient clinical data & evaluation outputs
# NOTE: keep the sample whitelist LAST so it wins over data/*
data/*
!data/sample/
!data/sample/**
# Real-data subfolders (already covered by data/*, listed for clarity)
data/260525/
data/260529/
data/ds_test/
data/export/
data/Updated_ds/

eval/
results/*.xlsx
results/260609*
2026-*/
175-*

# Data formats that may contain patient-level records
*.csv
!data/sample/*.csv
*.xlsx
*.xls
*.tsv

# Model weights (too large for git, typically downloaded)
*.gguf
*.bin
*.safetensors

